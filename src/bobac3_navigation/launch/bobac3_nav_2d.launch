<launch>
	<arg name="open_nav_rviz" default="true"/>
	<arg name="map_file_name" default="D123map"/>
	<arg name="location_method" default="amcl" 
				doc="location type [amcl, cartographer]"/>
	<arg name="map_directory" default="$(env MAP_DIRECTORY)"/>
	<!-- 国赛沿用省赛地图原点和定位框。
	     AMCL 原默认 (0,0,0) 与实际出发点相差约 14cm，窄通道中会被
	     TEB 判定为起步碰撞。在启动时直接使用已标定的出发点。 -->
	<arg name="initial_pose_x" default="-0.0914"/>
	<arg name="initial_pose_y" default="-0.1117"/>
	<arg name="initial_pose_a" default="0.0199"/>
	<!--bobac3 model description-->
	<include file="$(find bobac3_description)/launch/display.launch">
		<arg name="open_rviz" value="false"/>
	</include>
	<!--bobac3 base-->
	<include file="$(find rei_robot_base)/launch/base.launch"/>
	<!--laser sensor-->
  	<include file="$(find cspc_lidar)/launch/bobac3_lidar.launch" /> 
	<!--map_server-->
	<include file="$(find map_manager)/launch/map_load.launch">
		<arg name="map_file" value="$(arg map_file_name)"/>
		<arg name="map_directory" value="$(arg map_directory)"/>
	</include>
	<!--move_base-->
	<include file="$(find bobac3_navigation)/launch/move_base.launch"/>
	<!--location-->
	<include file="$(find bobac3_navigation)/launch/$(arg location_method).launch">
	 <arg name="map_file" value="$(arg map_file_name)"/>
	 <arg name="initial_pose_x" value="$(arg initial_pose_x)"/>
	 <arg name="initial_pose_y" value="$(arg initial_pose_y)"/>
	 <arg name="initial_pose_a" value="$(arg initial_pose_a)"/>
	</include>
	<!--virtual wall map publisher-->
	<node name="virtual_wall_map_publisher" pkg="ros_map_edit" type="virtual_wall_map_publisher.py">
		<param name="map_file" value="$(arg map_directory)/$(arg map_file_name).yaml"/>
	</node>
	
	<!--  **************** Visualisation ****************  -->
	<group if="$(arg open_nav_rviz)"> 
		<node pkg="rviz" type="rviz" name="rviz"
			args="-d $(find bobac3_navigation)/rviz/robot_navigation.rviz"/>
	</group>
</launch>

